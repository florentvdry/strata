{
  "name": "strata",
  "productName": "Strata",
  "version": "0.2.0",
  "description": "See what fills your disk, then clean it up. A fast, modern disk space analyzer for Windows and Linux.",
  "keywords": [
    "disk-space",
    "disk-usage",
    "treemap",
    "windirstat",
    "cleanup",
    "ntfs",
    "mft",
    "tauri",
    "windows",
    "linux"
  ],
  "homepage": "https://github.com/florentvdry/strata#readme",
  "bugs": {
    "url": "https://github.com/florentvdry/strata/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/florentvdry/strata.git"
  },
  "license": "MIT",
  "author": "Florent Vandroy",
  "private": true,
  "scripts": {
    "start": "node scripts/build-scanner.js --if-missing && tauri dev",
    "tauri": "tauri",
    "check": "node scripts/check-renderer.js && node scripts/i18n.js --check && node scripts/changelog.js check",
    "build:scanner": "node scripts/build-scanner.js",
    "test:scanner": "node scripts/test-scanner.js",
    "test:rust": "cargo test --locked --manifest-path scanner/Cargo.toml",
    "test:app": "cargo test --locked --manifest-path src/app/Cargo.toml",
    "test:scripts": "node --test \"scripts/test/*.test.js\"",
    "check:fast-scan": "node scripts/check-fast-scan.js",
    "signing:setup": "node scripts/setup-signing.js",
    "package": "node scripts/package-release.js",
    "build:icon": "node scripts/make-icon.js",
    "vendor": "node scripts/check-renderer.js --vendor",
    "changelog": "node scripts/changelog.js",
    "release": "node scripts/changelog.js release",
    "sync:changelog": "node scripts/changelog.js sync",
    "build": "node scripts/build-scanner.js && tauri build",
    "build:linux": "node scripts/build-scanner.js && tauri build --bundles deb,rpm,appimage",
    "screenshots": "node scripts/screenshots/capture.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "htm": "^3.1.1",
    "preact": "^11.0.2"
  }
}
